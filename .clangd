CompileFlags:
  Compiler: clang-cl
  Add:
    - --target=x86_64-pc-windows-msvc
    - /std:c++20
    - /Zc:__cplusplus
    - -DIVX_PLATFORM_WINDOWS
    - -DIVX_STATIC
    - -DIVX_CONFIG_DEBUG
    - -D_CRT_SECURE_NO_WARNINGS
    - -DNOMINMAX
    - -DIVX_INTRUSIVE_REF
    - -DTEXTURES="${CMAKE_CURRENT_SOURCE_DIR}/assets/textures/"
    - -DSHADERS="${CMAKE_CURRENT_SOURCE_DIR}/assets/shaders/"
    # IVX
    - -ID:/code/VSProjects/IVX/IVX/src
    # Glad / Elog / stb_image
    - -ID:/code/VSProjects/IVX/IVX/vendor/Glad/include
    - -ID:/code/VSProjects/IVX/IVX/vendor/Elog
    - -ID:/code/VSProjects/IVX/IVX/vendor/stb_image
    # GLFW / imgui / glm
    - -ID:/code/VSProjects/IVX/deps/glfw/include
    - -ID:/code/VSProjects/IVX/deps/imgui
    - -ID:/code/VSProjects/IVX/deps/imgui/backends
    - -ID:/code/VSProjects/IVX/deps/glm