# clangd setup for IVX.
#
# The authoritative flags come from compile_commands.json, generated by
# `tools/gen-compile-db.ps1` (the CMake VS generator cannot produce one). The
# entries below are a fallback so headers still resolve in a fresh clone where that
# file does not exist yet.
#
# Paths are relative to this file's directory, which keeps the config portable
# between machines and checkouts.
CompileFlags:
  Compiler: clang-cl
  Add:
    - --target=x86_64-pc-windows-msvc
    - /std:c++20
    - /Zc:__cplusplus
    - /permissive-
    - -DIVX_PLATFORM_WINDOWS
    - -DIVX_CONFIG_DEBUG
    - -D_CRT_SECURE_NO_WARNINGS
    - -DNOMINMAX
    - -DIVX_INTRUSIVE_REF
    - -DSCRIPTS_PANEL_LAYOUT="${CMAKE_CURRENT_SOURCE_DIR}/assets/scripts_panel.txt"
    - -IIVX/src
    - -IIVX/vendor/Glad/include
    - -IIVX/vendor/stb_image
    - -IIVX/vendor/entt/include
    - -IIVX/vendor/ImGuiColorTextEdit
    - -Ideps/imgui
    - -Ideps/imgui/backends
    - -Ideps/glm
    - -Ideps/BqLog/include
    - -Ideps/SDL/include
    - -Ideps/yaml-cpp/include
    - -Ideps/ImGuizmo/src
  # Switches clang-cl does not implement; keeping them would make clangd drop the
  # whole command instead of just ignoring them.
  Remove:
    - /W4
    - /MP
    - /Zc:preprocessor
    - /EHsc
    - /GR-
    - /utf-8

Diagnostics:
  UnusedIncludes: None
  ClangTidy:
    # Formatting and style are owned by clang-format, not by clang-tidy.
    Add: []
    Remove: ["*"]

InlayHints:
  Designators: true
  ParameterNames: true
  DeducedTypes: true
