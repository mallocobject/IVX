{
  "cmake.sourceDirectory": "${workspaceFolder}",
  "cmake.buildDirectory": "${workspaceFolder}/build",
  "cmake.generator": "Visual Studio 18 2026",
  "cmake.platform": "x64",
  "cmake.configureOnOpen": true,

  // Language server: clangd, driven by compile_commands.json in the repo root.
  // Regenerate it with tools/gen-compile-db.ps1 (the VS generator cannot export one).
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}",
    "--background-index",
    "--clang-tidy=false",
    "--header-insertion=never",
    "--pch-storage=memory"
  ],
  "C_Cpp.intelliSenseEngine": "disabled",
  "C_Cpp.autocomplete": "disabled",
  "C_Cpp.errorSquiggles": "disabled",

  // Formatting: clangd hands the document to clang-format, which reads
  // .clang-format from the repo root. One formatter for IDE and CI.
  "editor.formatOnSave": true,
  "[cpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
  },
  "[c]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
  },
  "files.eol": "\r\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true
}
