#pragma once

// Generated by CMake from ref_config.hpp.in -- do not edit, and do not commit.
//
// Presence of IVX_INTRUSIVE_REF selects the implementation behind ivx::Ref:
//   defined     -> intrusive counting, the count lives in RefCounted
//                  (Ref is one pointer wide, no control block)
//   not defined -> std::shared_ptr
//                  (Ref is two pointers wide, one allocation per object)
//
// The build writes this file on every configure, so flipping the
// IVX_INTRUSIVE_REF option changes its timestamp and forces every translation
// unit that includes ivx/core/ref.hpp to rebuild. Never mix the two modes in
// one binary: Ref has a different layout in each of them.
#cmakedefine IVX_INTRUSIVE_REF
